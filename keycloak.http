### http://localhost:8085/realms/fiware/account
### hay que poner tambien el nombre y el apellido del usuario, sino no se le asignan los roles y no funciona la autenticación
curl -s -X POST \
  http://owsei.ddns.net:8080/realms/fiware/protocol/openid-connect/token \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "grant_type=password" \
  -d "client_id=fiware-client-users" \
  -d "username=pedro" \
  -d "password=1111" 
  
